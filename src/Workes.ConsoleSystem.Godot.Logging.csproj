<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Workes.ConsoleSystem.Godot.Logging</PackageId>
    <Version>0.1.0</Version>
    <PackageReleaseNotes>Initial Godot custom Logger attachment with configurable severity mapping, source metadata, and disposal-safe forwarding.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Workes</Authors>
    <Company>Workes</Company>
    <Product>Workes.ConsoleSystem.Godot.Logging</Product>
    <Description>Optional Godot 4.7+ logger adapter for Workes.ConsoleSystem.</Description>
    <PackageTags>godot logging console logging-adapter</PackageTags>
    <PackageProjectUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem.Godot.Logging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem.Godot.Logging.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Workes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Workes.ConsoleSystem" Version="0.9.0" />
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>
</Project>